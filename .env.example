APP_NAME=Opslira
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_ENCRYPTION_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=monitoring-postgres
DB_PORT=5432
DB_DATABASE=internal_monitoring
DB_USERNAME=mon_admin
DB_PASSWORD=change-me-strong-password

REDIS_CLIENT=predis
REDIS_HOST=monitoring-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
# No PHP queue worker runs; jobs execute inline from the runner endpoints
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis

GOTENBERG_URL=http://monitoring-gotenberg:3000

MAIL_MAILER=smtp
MAIL_HOST=smtp.kantor.co.id
MAIL_PORT=587
MAIL_USERNAME=opslira@kantor.co.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=opslira@kantor.co.id
MAIL_FROM_NAME="Opslira Monitoring"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Comma-separated incident alert recipients, e.g. noc@kantor.co.id,ops@kantor.co.id
# Required: with this empty no incident alert email is sent at all.
ALERT_RECIPIENTS=

# Shared secret the Go runner sends to the /internal endpoints; required
OPSLIRA_RUNNER_TOKEN=

# Supervisor-run artisan workers inside the web container. Keep false while the
# monitoring-runner service is alive: both would dispatch the same probes and
# reports. Intervals are seconds.
RUN_ARTISAN_WORKERS=false
RUN_ARTISAN_QUEUE=false
ARTISAN_QUEUE_NAMES=alerts,probes,reports
ARTISAN_PROBE_SECONDS=60
ARTISAN_REPORT_SECONDS=60
ARTISAN_ROLLUP_SECONDS=3600
ARTISAN_PRUNE_SECONDS=86400

# Set smtps for implicit TLS on port 465; port 587 uses STARTTLS when the server advertises it
MAIL_SCHEME=

# Seconds to wait for the SMTP server before the send is reported as failed.
MAIL_TIMEOUT=10

# MAIL_PASSWORD must be filled in: an empty password makes the relay reject AUTH.
# Keep MAIL_VERIFY_PEER=true (verify) unless the relay uses a self-signed
# certificate on an internal network, in which case set it to false.
MAIL_VERIFY_PEER=true

# MAIL_FROM_ADDRESS must be an address the relay is allowed to send as, or the
# relay rejects the message after a successful login.

BESZEL_TOKEN_CACHE_TTL=43200

INERTIA_SSR_ENABLED=false
VITE_APP_NAME="${APP_NAME}"

# Seed produksi (ProductionSeeder): hanya superadmin, tanpa data contoh.
# ADMIN_PASSWORD wajib diisi saat seeding produksi.
ADMIN_EMAIL=admin@opslira.local
ADMIN_NAME="Opslira Super Admin"
ADMIN_PASSWORD=
