# ---------------------------------------------------------------------------
# Opslira — environment for docker-compose.yml (full) and
# docker-compose.slim.yml (frontend + backend only).
# Copy to .env and fill in the secrets before `docker compose up`.
#
# Full stack pins the backend to the bundled postgres/redis/gotenberg
# services (DB_HOST/REDIS_HOST/GOTENBERG_URL below are IGNORED there).
# Slim uses external Postgres/Redis: point DB_HOST/REDIS_HOST at
# infrastructure you run, and leave GOTENBERG_URL empty to skip PDF output
# (XLSX/HTML reports keep working; PDF reports fail per-report).
# ---------------------------------------------------------------------------

# Go API listen address (inside the container)
API_LISTEN_ADDR=:8080

# Browser origin of the SPA; used for CORS and cookie scoping. Must be the
# exact origin (scheme://host:port). The nginx frontend is served on
# http://localhost (port 80) by default; when running `npm run dev` (Vite on
# http://localhost:5173) set FRONTEND_ORIGIN=http://localhost:5173 instead,
# otherwise the browser blocks the cross-origin requests.
FRONTEND_ORIGIN=http://localhost

# Session lifetime in seconds
SESSION_TTL_SECONDS=86400

# Build-time base URL the SPA uses to reach the API (baked by Vite at image
# build). Must include the /api/v1 prefix: it is used verbatim as the axios
# baseURL. Defaults to the published backend port on localhost.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# External PostgreSQL 16
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=internal_monitoring
DB_USERNAME=mon_admin
DB_PASSWORD=change-me-strong-password
DB_SSLMODE=disable

# External Redis 7 — sessions and cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Optional Gotenberg (headless Chromium HTML→PDF); empty disables PDF output
GOTENBERG_URL=

# Where generated report files land (compose mounts a named volume here)
REPORT_STORAGE_DIR=/data/reports

# Optional S3 archive for generated reports (PDF+XLSX, all periods). Empty
# endpoint = upload skipped, local files only. Example RustFS endpoint:
# https://s3-api.vezaro.biz.id
REPORT_S3_ENDPOINT=
REPORT_S3_BUCKET=opslira-reports
REPORT_S3_ACCESS_KEY=
REPORT_S3_SECRET_KEY=
REPORT_S3_REGION=us-east-1
REPORT_S3_PREFIX=opslira-reports

# Laravel-style app key (32-byte base64) used for signed values
APP_KEY=
# Separate key for credential encryption at rest; generate with e.g.
# `openssl rand -base64 32`
APP_ENCRYPTION_KEY=

# Shared secret the API sends to its own /internal endpoints; required.
# Generate with `openssl rand -hex 32`.
OPSLIRA_RUNNER_TOKEN=

# Scheduler tuning
PROBE_CONCURRENCY=8
RUNNER_TICK_SECONDS=15
REPORT_TICK_SECONDS=60
# Daily HH:MM in RUNNER_TIMEZONE
ROLLUP_AT=00:05
PRUNE_AT=02:00
RUNNER_TIMEZONE=Asia/Jakarta

# Comma-separated incident alert recipients, e.g. noc@kantor.co.id,ops@kantor.co.id
ALERT_RECIPIENTS=

# Outgoing mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.kantor.co.id
MAIL_PORT=587
MAIL_USERNAME=opslira@kantor.co.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=opslira@kantor.co.id
MAIL_FROM_NAME="Opslira Monitoring"
# smtps for implicit TLS on port 465; port 587 uses STARTTLS when the server
# advertises it
MAIL_SCHEME=

# Chat alert channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Production seed switch: set ADMIN_PASSWORD to seed the superadmin ONLY
# (no targets, no schedules). Leave empty for the dev seed instead
# (4 users / 8 targets / 3 schedules).
ADMIN_EMAIL=admin@opslira.local
ADMIN_NAME="Opslira Super Admin"
ADMIN_PASSWORD=

# Beszel API token cache TTL in seconds
BESZEL_TOKEN_CACHE_TTL=43200
